# Copy to apps/api/.env for local development: cp .env.example apps/api/.env
# Values below match docker-compose.yml.

# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API (the web dev server by default).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# --- Data stores ---
DATABASE_URL=postgres://videochat:videochat@localhost:5432/videochat
# Used by `pnpm test` for integration tests against a real database.
TEST_DATABASE_URL=postgres://videochat:videochat@localhost:5432/videochat_test
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Dev-only value, at least 32 chars. Generate a real one for staging/production, e.g.
# `openssl rand -hex 32`, and never commit it.
JWT_SECRET=dev-only-secret-do-not-use-in-production-32chars
PUBLIC_WEB_URL=http://localhost:5173

# --- Object storage (MinIO locally, S3/R2 in the cloud) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videochat-uploads
S3_ACCESS_KEY_ID=videochat
S3_SECRET_ACCESS_KEY=videochat-secret

# --- Email (Mailpit locally) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Videochat <no-reply@videochat.local>"

# --- Observability (all optional; leave empty to disable) ---
SENTRY_DSN=
# e.g. http://localhost:4318 for a local OpenTelemetry collector / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=videochat-api

# --- Web (Vite reads VITE_* variables from apps/web/.env) ---
VITE_API_URL=http://localhost:3000
VITE_SENTRY_DSN=
