# Copy to apps/api/.env for local development: cp .env.example apps/api/.env
# Values below match docker-compose.yml.

# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API (the web dev server by default).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# --- Data stores ---
DATABASE_URL=postgres://videochat:videochat@localhost:5432/videochat
# Used by `pnpm test` for integration tests against a real database.
TEST_DATABASE_URL=postgres://videochat:videochat@localhost:5432/videochat_test
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Dev-only value, at least 32 chars. Generate a real one for staging/production, e.g.
# `openssl rand -hex 32`, and never commit it.
JWT_SECRET=dev-only-secret-do-not-use-in-production-32chars
PUBLIC_WEB_URL=http://localhost:5173

# --- Object storage (MinIO locally, S3/R2 in the cloud) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videochat-uploads
S3_ACCESS_KEY_ID=videochat
S3_SECRET_ACCESS_KEY=videochat-secret

# --- Email (Mailpit locally) ---
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Videochat <no-reply@videochat.local>"

# --- Rate limiting (CHAT-021; defaults shown -- change and restart, no rebuild needed) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_SEC=10
RATE_LIMIT_MESSAGES_MAX=20
RATE_LIMIT_MESSAGES_WINDOW_SEC=10
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW_SEC=3600

# --- Calls: STUN/TURN (CHAT-040) ---
# Public STUN by default. TURN_PROVIDER=none|hmac|cloudflare (see docs/DEPLOYMENT.md).
# The hmac values below match the local coturn container in docker-compose.yml.
STUN_URLS=stun:stun.l.google.com:19302
TURN_PROVIDER=none
# TURN_PROVIDER=hmac
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# TURN_SECRET=local-dev-turn-secret-change-me
TURN_TTL_SEC=3600
# TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# --- Observability (all optional; leave empty to disable) ---
SENTRY_DSN=
# e.g. http://localhost:4318 for a local OpenTelemetry collector / Jaeger
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=videochat-api

# --- Web (Vite reads VITE_* variables from apps/web/.env) ---
VITE_API_URL=http://localhost:3000
VITE_SENTRY_DSN=
