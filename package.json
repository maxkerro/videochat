{
  "name": "videochat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "sh scripts/setup-hooks.sh",
    "dev": "turbo run dev --filter=@videochat/api --filter=@videochat/web --filter=@videochat/shared",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @videochat/api db:generate",
    "db:migrate": "pnpm --filter @videochat/api db:migrate",
    "db:seed": "pnpm --filter @videochat/api db:seed",
    "db:reset": "pnpm --filter @videochat/api db:reset",
    "test:hooks": "sh scripts/test-pre-push-hook.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "esbuild",
      "@sentry/cli",
      "protobufjs"
    ]
  }
}
