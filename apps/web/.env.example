# For local dev only, so the web app talks to your locally-running API directly.
# Leave this UNSET in production: the web static site proxies API paths through to
# videochat-api itself (see render.yaml), which keeps the refresh-token cookie same-site.
VITE_API_URL=http://localhost:3000

# CHAT-013: the realtime WebSocket endpoint. Unlike VITE_API_URL, this is set in production
# too (see render.yaml) -- the socket authenticates with the access token as a query
# parameter, not a cookie, so it always connects straight to the API rather than through the
# same-origin proxy. Defaults to same-origin `/realtime` if unset, which is right for
# `pnpm dev` behind a dev-server proxy but not for talking to a bare `pnpm --filter api dev`.
VITE_REALTIME_URL=ws://localhost:3000/realtime
