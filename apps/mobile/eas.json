{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "staging": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "staging" },
      "channel": "staging",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "production": {
      "env": { "APP_VARIANT": "production" },
      "channel": "production",
      "autoIncrement": true
    }
  }
}
